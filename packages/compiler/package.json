{
  "name": "@tsplc/compiler",
  "license": "MIT",
  "description": "Write CODESYS PLC programs in TypeScript and compile them to IEC 61131-3 Structured Text. Provides the tsplc CLI.",
  "keywords": [
    "plc",
    "codesys",
    "iec-61131-3",
    "structured-text",
    "typescript",
    "compiler"
  ],
  "homepage": "https://github.com/livingforjesus/tsplc#readme",
  "bugs": "https://github.com/livingforjesus/tsplc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livingforjesus/tsplc.git",
    "directory": "packages/compiler"
  },
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ir": {
      "types": "./ir/index.ts",
      "bun": "./ir/index.ts",
      "default": "./dist/ir.js"
    },
    "./codesys": {
      "types": "./backends/codesys/index.ts",
      "bun": "./backends/codesys/index.ts",
      "default": "./dist/codesys.js"
    },
    "./project": {
      "types": "./project/index.ts",
      "bun": "./project/index.ts",
      "default": "./dist/project.js"
    },
    "./math": {
      "types": "./stdlib/math.ts",
      "bun": "./stdlib/math.ts",
      "default": "./dist/math.js"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.d.ts"
    },
    "./globals": {
      "types": "./types/globals.d.ts",
      "default": "./types/globals.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "ir",
    "backends",
    "project",
    "types",
    "stdlib",
    "!**/*.test.ts",
    "!**/__tests__/**"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@tsplc/build": "workspace:*",
    "@tsplc/config": "workspace:*",
    "@tsplc/typegen": "workspace:*",
    "typescript": "6.0.3",
    "zod": "4.3.6",
    "jiti": "2.7.0",
    "@types/bun": "1.4.2"
  },
  "bin": {
    "tsplc": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
