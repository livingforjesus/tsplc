                ,,                      $ target config size, format
                "PLCIO with Reset Protection",    $ Connection Name
                "",                     $ help string
                "20 04 25 00 01 00 2D 00 34 01 2D 00 33 01";    $ Path

[Port]
        Object_Name = "Port Object";
        Object_Class_Code = 0xF4;
        Port1 =
                TCP,
                "EtherNet/IP port",
                "20 F5 24 01",
                1,
                0,
                ;


[Ethernet Link Class]
        Revision = 3;
        Object_Name = "Ethernet Link Object";
        Object_Class_Code = 0xF6;
        MaxInst = 3;
        Number_Of_Static_Instances = 3;
        Max_Number_Of_Dynamic_Instances = 0;
        InterfaceLabel1 = "Internal_Port";
        InterfaceLabel2 = "Port1";
        InterfaceLabel3 = "Port2";
        InterfaceType1 = 1;
        InterfaceType2 = 2;             $ 2=Twisted Pair
        InterfaceType3 = 2;


