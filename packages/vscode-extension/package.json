{
  "name": "tsplc-vscode-extension",
  "displayName": "tsPLC",
  "description": "TypeScript PLC tooling, Structured Text language support, hardware IO views and read-only CODESYS monitoring.",
  "version": "0.1.2",
  "publisher": "livingforjesus",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "repository": {
    "url": "https://github.com/livingforjesus/tsplc"
  },
  "keywords": [
    "CODESYS",
    "PLC",
    "IEC 61131-3",
    "Structured Text",
    "codesys-build"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:codesys-st",
    "onLanguage:st",
    "workspaceContains:**/tsplc.config.ts",
    "onView:tsplc.hardware"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "codesys-st",
        "aliases": [
          "CODESYS Structured Text",
          "Structured Text",
          "ST"
        ],
        "extensions": [
          ".st",
          ".iecst"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/st-light.svg",
          "dark": "./icons/st-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "codesys-st",
        "scopeName": "source.codesys-st",
        "path": "./syntaxes/codesys-st.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "codesys-st",
        "path": "./snippets/codesys-st.json"
      }
    ],
    "commands": [
      {
        "command": "codesysST.restartServer",
        "title": "CODESYS ST: Restart Language Server"
      },
      {
        "command": "codesysST.openCounterpart",
        "title": "CODESYS ST: Open Declaration / Implementation"
      },
      {
        "command": "tsplc.typegen",
        "title": "tsPLC: Generate Types"
      },
      {
        "command": "tsplc.check",
        "title": "tsPLC: Check Project"
      },
      {
        "command": "tsplc.build",
        "title": "tsPLC: Build Project"
      },
      {
        "command": "tsplc.install",
        "title": "tsPLC: Install Libraries"
      },
      {
        "command": "tsplc.connect",
        "title": "tsPLC: Connect Monitor"
      },
      {
        "command": "tsplc.disconnect",
        "title": "tsPLC: Disconnect Monitor"
      },
      {
        "command": "tsplc.forgetMonitorPassword",
        "title": "tsPLC: Forget Monitor Password"
      },
      {
        "command": "tsplc.refresh",
        "title": "tsPLC: Refresh Hardware"
      }
    ],
    "configuration": {
      "title": "CODESYS Structured Text",
      "properties": {
        "codesysST.sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Source directories relative to each workspace folder. Empty discovers tsplc.config.ts projects and their generated ST, or raw src folders. Config files are never executed."
        },
        "codesysST.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories containing declaration-only .st signatures for vendor libraries, relative to each workspace folder. Indexed in each project; no code is executed."
        },
        "codesysST.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace language-server messages in the output channel."
        }
      }
    },
    "configurationDefaults": {
      "[codesys-st]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsplc",
          "title": "tsPLC",
          "icon": "icons/st-light.svg"
        }
      ]
    },
    "views": {
      "tsplc": [
        {
          "id": "tsplc.hardware",
          "name": "Hardware & IO",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "vscode:prepublish": "bun run build",
    "test": "bun test tests --timeout 20000",
    "test:host": "bun scripts/test-host.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out artifacts/tsplc.vsix"
  },
  "dependencies": {
    "@tsplc/build": "workspace:*",
    "@tsplc/config": "workspace:*",
    "@tsplc/typegen": "workspace:*",
    "node-opcua-client": "2.187.5",
    "node-opcua-certificate-manager": "2.187.0",
    "proper-lockfile": "4.1.2",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-languageserver-types": "3.17.5",
    "vscode-uri": "3.1.0"
  },
  "private": true,
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "24.10.4",
    "esbuild": "0.27.4",
    "@vscode/vsce": "^3.7.1",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "6.0.3",
    "fast-check": "^4.0.0",
    "vscode-textmate": "^9.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-jsonrpc": "8.2.1"
  }
}
