{
  "Function block": {
    "prefix": "fb",
    "body": [
      "FUNCTION_BLOCK ${1:FB_Name}",
      "VAR_INPUT",
      "\t${2:Enable} : BOOL;",
      "END_VAR",
      "VAR_OUTPUT",
      "\t${3:Done} : BOOL;",
      "END_VAR",
      "VAR",
      "\t$4",
      "END_VAR",
      "",
      "$0",
      "END_FUNCTION_BLOCK"
    ],
    "description": "CODESYS function block"
  },
  "Program": {
    "prefix": "program",
    "body": ["PROGRAM ${1:Main}", "VAR", "\t$2", "END_VAR", "", "$0", "END_PROGRAM"]
  },
  "Function": {
    "prefix": "function",
    "body": [
      "FUNCTION ${1:F_Name} : ${2:BOOL}",
      "VAR_INPUT",
      "\t${3:Value} : $2;",
      "END_VAR",
      "",
      "$1 := $3;",
      "$0",
      "END_FUNCTION"
    ]
  },
  "Method": {
    "prefix": "method",
    "body": [
      "METHOD PUBLIC ${1:Run} : ${2:BOOL}",
      "VAR_INPUT",
      "\t$3",
      "END_VAR",
      "",
      "$0",
      "END_METHOD"
    ]
  },
  "Split method declaration": {
    "prefix": "method-declaration",
    "body": ["METHOD PUBLIC ${1:Run}", "VAR_INPUT", "\t${2:Asserted} : BOOL;", "END_VAR", "$0"],
    "description": "Declaration for codesys-build's split method layout"
  },
  "Structure": {
    "prefix": "struct",
    "body": [
      "TYPE ${1:ST_Name} :",
      "STRUCT",
      "\t${2:Enabled} : BOOL;",
      "\t$0",
      "END_STRUCT",
      "END_TYPE"
    ]
  },
  "Strict enum": {
    "prefix": "enum",
    "body": [
      "{attribute 'qualified_only'}",
      "{attribute 'strict'}",
      "TYPE ${1:E_State} :",
      "(",
      "\t${2:Idle} := 0,",
      "\t${3:Running},",
      "\t${4:Faulted}",
      ");",
      "END_TYPE",
      "$0"
    ]
  },
  "Qualified globals": {
    "prefix": "gvl",
    "body": [
      "{attribute 'qualified_only'}",
      "VAR_GLOBAL",
      "\t${1:Enabled} : BOOL;",
      "\t$0",
      "END_VAR"
    ]
  },
  "If": {
    "prefix": "if",
    "body": ["IF ${1:condition} THEN", "\t$0", "END_IF;"]
  },
  "For": {
    "prefix": "for",
    "body": ["FOR ${1:Index} := ${2:1} TO ${3:10} DO", "\t$0", "END_FOR;"]
  },
  "Case": {
    "prefix": "case",
    "body": ["CASE ${1:State} OF", "\t${2:E_State.Idle}:", "\t\t$0", "ELSE", "\t", "END_CASE;"]
  },
  "Property declaration": {
    "prefix": "property",
    "body": ["PROPERTY PUBLIC ${1:Enabled} : ${2:BOOL}", "$0"],
    "description": "Put get.st and/or set.st next to declaration.st"
  }
}
